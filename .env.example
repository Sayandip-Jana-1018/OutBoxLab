# ---------------------------------------------------------------------------
# OutboxLab - single environment file for the whole monorepo
#
#   cp .env.example .env        (PowerShell: Copy-Item .env.example .env)
#
# The backend loads this file directly; the frontend loads it through
# next.config.ts, so NEXT_PUBLIC_* values defined here reach the browser.
# Every value below has a working default - the stack boots with zero edits.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=info

# --- Frontend (browser-exposed) --------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:5000

# --- PostgreSQL ------------------------------------------------------------
# Must match the credentials in docker-compose.yml.
POSTGRES_USER=outboxlab
POSTGRES_PASSWORD=outboxlab
POSTGRES_DB=outboxlab
POSTGRES_PORT=5432
DATABASE_URL=postgresql://outboxlab:outboxlab@localhost:5432/outboxlab?schema=public

# --- Redis -----------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Auth ------------------------------------------------------------------
# CHANGE THIS IN PRODUCTION. Minimum 32 characters.
JWT_SECRET=outboxlab_dev_secret_change_me_please_32_chars_min
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# Seeded demo account (created by `npm run db:seed`) so a reviewer can log in
# immediately without registering.
DEMO_EMAIL=demo@outboxlab.dev
DEMO_PASSWORD=demo1234
DEMO_NAME=Demo Reviewer

# --- Scheduling engine -----------------------------------------------------
# Number of jobs a single worker process handles in parallel.
WORKER_CONCURRENCY=5
# Global queue throttle: at most QUEUE_LIMITER_MAX jobs per QUEUE_LIMITER_DURATION ms.
QUEUE_LIMITER_MAX=20
QUEUE_LIMITER_DURATION=1000
# Rate-limit window length. 3600000 = 1 hour. The Time Machine can shrink this
# at runtime (e.g. to 60000) so rate limiting is demoable in a short video.
RATE_WINDOW_MS=3600000
# Fallback per-sender cap when a campaign/sender does not specify one.
DEFAULT_HOURLY_LIMIT=10
# Minimum spacing between two sends from the same sender.
DEFAULT_MIN_DELAY_MS=2000
# Retry attempts for genuine send failures (rate-limit deferrals are NOT retries).
MAX_JOB_ATTEMPTS=3
# Interval of the drift sweeper that re-queues DB rows missing from Redis.
SWEEPER_INTERVAL_MS=60000
# Allow POST /api/system/time-machine to change RATE_WINDOW_MS at runtime.
ENABLE_TIME_MACHINE=true

# --- Bull Board (queue inspector at /admin/queues) -------------------------
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=admin

# --- SMTP ------------------------------------------------------------------
# Leave blank to use Ethereal. OutboxLab can auto-provision Ethereal mailboxes
# from the dashboard ("Generate Ethereal mailbox"), so no credentials are
# needed for local testing. Set these only to pin a fixed Ethereal/SMTP inbox.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
